{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "root": false,
  "files": {
    "includes": ["**/*.ts"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 8
          }
        }
      }
    }
  }
}
